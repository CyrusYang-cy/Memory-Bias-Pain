# Railway variables for the pain study. In Railway: your service → Variables → Raw Editor,
# paste this, then replace every <...> value. Never commit the filled-in version.
# All settings and their defaults: backend/app/config.py.

# --- Server -------------------------------------------------------------------------
ENVIRONMENT_TYPE=production
ADMIN_USERNAME=<choose a username>
ADMIN_PASSWORD=<choose a long random password>
# Railway fills this in from the attached Postgres service (keep the ${{...}} as is).
DATABASE_URL=${{Postgres.DATABASE_URL}}
# Only for `railway run uv run python cli.py export` from your laptop (the server ignores it).
DATABASE_PUBLIC_URL=${{Postgres.DATABASE_PUBLIC_URL}}

# --- Experiment -----------------------------------------------------------------------
DEBUG_MODE=0
EXPERIMENT_NAME=memory_bias_pain
EXPERIMENT_TITLE=Face memory study
VERSION_DATE=2026-10-16
ESTIMATED_TASK_DURATION=15 minutes
COMPENSATION=$3.00
CONTACT_EMAIL=cy36@illinois.edu
# Identities per group: 7 → one trial per pain identity, seven trials.
NUM_IDENTITIES=7
# Unfinished sessions stop counting for image balancing after this many minutes.
ABANDON_AFTER_MINUTES=120

# --- End of session -------------------------------------------------------------------
# Prolific: the study's completion link.
REDIRECT_URL=https://app.prolific.com/submissions/complete?cc=<your completion code>
# SONA instead: REDIRECT_URL=https://uiuc.sona-systems.com/webstudy_credit.aspx?
# plus the two values below (participants are sent to REDIRECT_URL + experiment_id=…
# &credit_token=…&survey_code=<sona_id>).
EXPERIMENT_ID=
CREDIT_TOKEN=
