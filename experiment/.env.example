# Copy to `.env` (local) or set these in Railway → Variables (production).
# Every setting and its default is documented in backend/app/config.py.

# --- Server ---------------------------------------------------------------------
ENVIRONMENT_TYPE=debug            # "production" hides /docs
ADMIN_USERNAME=admin              # for /api/admin/* (basic auth)
ADMIN_PASSWORD=change-me
# DATABASE_URL=postgresql://...   # Railway provides this; unset = local SQLite (pain.db)

# --- Experiment -----------------------------------------------------------------
DEBUG_MODE=0                      # 1 = show data at the end instead of saving; enables ?skip= etc.
EXPERIMENT_NAME=memory_bias_pain
EXPERIMENT_TITLE=Face memory study
VERSION_DATE=2026-10-16
ESTIMATED_TASK_DURATION=15 minutes
COMPENSATION=$3.00
CONTACT_EMAIL=cy36@illinois.edu
NUM_IDENTITIES=7                 # first N identities per group in stimuli/study.json
ABANDON_AFTER_MINUTES=120         # unfinished sessions stop counting for balancing

# --- Where participants go at the end ------------------------------------------------
# SONA participants: REDIRECT_URL + experiment_id/credit_token/survey_code (end it with "?").
# Everyone else: REDIRECT_URL as is. Leave empty to show a completion code instead.
REDIRECT_URL=https://app.prolific.com/submissions/complete?cc=XXXXXXX
EXPERIMENT_ID=
CREDIT_TOKEN=
